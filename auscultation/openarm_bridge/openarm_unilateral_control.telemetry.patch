             for (size_t i = 0; i < wam::openarm_bridge::kOpenArmJointCount; ++i) {
                 const auto feedback =
                     arm_motors[i].get_feedback_liveness_snapshot();
                 telemetry_record.follower_q_rad[i] = joint_arm_states[i].position;
                 telemetry_record.follower_qd_rad_s[i] =
                     joint_arm_states[i].velocity;
                 telemetry_record.follower_arm_mit[i] = {
                     arm_cmds[i].kp,
                     arm_cmds[i].kd,
                     arm_cmds[i].q,
                     arm_cmds[i].dq,
                     arm_cmds[i].tau,
                 };
                 telemetry_record.follower_arm_state_rx_motor_ids[i] =
                     feedback.motor_id;
                 telemetry_record.follower_arm_state_rx_counters[i] =
                     feedback.counter;
                 telemetry_record.follower_arm_state_rx_generations[i] =
                     feedback.generation;
                 telemetry_record.follower_arm_state_rx_monotonic_ns[i] =
                     feedback.monotonic_ns;
                 telemetry_record.follower_arm_state_rx_last_gap_ns[i] =
                     feedback.last_gap_ns;
                 telemetry_record
                     .follower_arm_state_rx_gap_violation_counts[i] =
