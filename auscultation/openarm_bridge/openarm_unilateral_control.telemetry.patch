         dynamics_f_->GetGravity(joint_arm_positions.data(), gravity.data());
 
         if (!ref_lim_ready_) {
             ref_lim_ready_ = dynamics_f_->GetJointLimits(ref_lim_lo_, ref_lim_hi_);
         }
 
         for (size_t i = 0; i < arm_dof; ++i) {
