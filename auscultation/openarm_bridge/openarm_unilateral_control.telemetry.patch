             }
             // Divergence governor: bound the position error fed to the PD.
             const double q_now = joint_arm_positions[i];
             q_ref = std::clamp(q_ref, q_now - REF_GOVERNOR, q_now + REF_GOVERNOR);
 
             joint_arm_states_ref[i].position = q_ref;
             joint_arm_states_ref[i].effort = gravity[i];
