         // Env: GRIP_LEAD sets the lead (force) cap; GRIPPER_DECOUPLE=1 switches to
         // hold-open mode (ramp to GRIPPER_HOLD_POS, default fully open, and stay).
-        static const bool grip_decouple = [] {
-            const char* e = std::getenv("GRIPPER_DECOUPLE");
-            return e != nullptr && e[0] == '1';
-        }();
-        static const double grip_lead = [] {
+        const bool grip_decouple = follower_gripper_hold_enabled_;
+        static const double compliant_grip_lead = [] {
             const char* e = std::getenv("GRIP_LEAD");
             return std::clamp(e != nullptr ? std::atof(e) : 0.08, 0.02, 0.3);
         }();
-        static const double grip_target = [] {
-            const char* e = std::getenv("GRIPPER_HOLD_POS");
-            return e != nullptr ? std::atof(e) : GRIP_OPEN_POS;
-        }();
+        const double grip_lead = grip_decouple
+                                     ? follower_gripper_max_lead_rad_
+                                     : compliant_grip_lead;
+        const double grip_target = follower_gripper_hold_position_rad_;
         if (!grip_hold_init_ && gripper_dof > 0) {
             grip_hold_init_ = true;
             grip_hold_pos_ = joint_gripper_positions[0];
             std::cout << (grip_decouple ? "[follower] gripper decoupled (hold-open mode)"
                                         : "[follower] gripper compliant-follow")
                       << ", lead=" << grip_lead << " rad (~" << grip_lead * 25.0 << " Nm cap)"
                       << std::endl;
         }
         if (grip_decouple) {
             const double step = GRIP_RAMP_RATE * Ts_;
             grip_hold_pos_ += std::clamp(grip_target - grip_hold_pos_, -step, step);
             grip_hold_pos_ = std::clamp(grip_hold_pos_, joint_gripper_positions[0] - grip_lead,
                                         joint_gripper_positions[0] + grip_lead);
             for (auto& js : joint_hand_states_ref) {
                 js.position = grip_hold_pos_;
                 js.velocity = 0.0;
                 js.effort = 0.0;
             }
         } else {
             for (size_t i = 0; i < joint_hand_states_ref.size(); ++i) {
                 const double q_now =
                     (i < joint_gripper_positions.size()) ? joint_gripper_positions[i] : 0.0;
                 double q_ref = joint_hand_states_ref[i].position;  // leader gripper
                 q_ref = std::clamp(q_ref, q_now - grip_lead, q_now + grip_lead);
                 joint_hand_states_ref[i].position = q_ref;
                 joint_hand_states_ref[i].velocity = 0.0;
                 joint_hand_states_ref[i].effort = 0.0;
             }
         }
 
         // Gravity feedforward from the follower URDF (includes the stethoscope
