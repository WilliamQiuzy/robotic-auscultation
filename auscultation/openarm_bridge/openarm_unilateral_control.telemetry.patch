             const auto feedback =
                 gripper_motors[0].get_feedback_liveness_snapshot();
             telemetry_record.follower_gripper_q_rad =
                 joint_gripper_states[0].position;
             telemetry_record.follower_gripper_qd_rad_s =
                 joint_gripper_states[0].velocity;
             telemetry_record.follower_gripper_motor_q_rad =
                 gripper_motor_states[0].position;
             telemetry_record.follower_gripper_motor_qd_rad_s =
                 gripper_motor_states[0].velocity;
             telemetry_record.follower_gripper_mit = {
                 hand_cmds[0].kp,
                 hand_cmds[0].kd,
                 hand_cmds[0].q,
                 hand_cmds[0].dq,
                 hand_cmds[0].tau,
             };
             telemetry_record.follower_gripper_state_rx_motor_id =
                 feedback.motor_id;
             telemetry_record.follower_gripper_state_rx_counter =
                 feedback.counter;
             telemetry_record.follower_gripper_state_rx_generation =
                 feedback.generation;
             telemetry_record.follower_gripper_state_rx_monotonic_ns =
                 feedback.monotonic_ns;
             telemetry_record.follower_gripper_state_rx_last_gap_ns =
                 feedback.last_gap_ns;
             telemetry_record.follower_gripper_state_rx_gap_violation_count =
                 feedback.gap_violation_count;
         } else {
             telemetry_record.reference_snapshot_valid = false;
         }
         if (joint_arm_states.size() != wam::openarm_bridge::kOpenArmJointCount ||
             arm_cmds.size() != wam::openarm_bridge::kOpenArmJointCount ||
             arm_motors.size() != wam::openarm_bridge::kOpenArmJointCount) {
             telemetry_record.reference_snapshot_valid = false;
         }
 
         telemetry_record.control_call_begin_monotonic_ns =
             wam::openarm_bridge::monotonic_now_ns();
         const auto arm_tx_status = openarm_->get_arm().mit_control_all(arm_cmds);
         telemetry_record.arm_tx_expected_frame_count = arm_tx_status.expected_frame_count;
         telemetry_record.arm_tx_full_frame_write_count = arm_tx_status.full_frame_write_count;
         telemetry_record.arm_tx_failed_frame_write_count = arm_tx_status.failed_frame_write_count;
         telemetry_record.arm_call_return_monotonic_ns =
             wam::openarm_bridge::monotonic_now_ns();
         telemetry_record.gripper_call_begin_monotonic_ns =
             wam::openarm_bridge::monotonic_now_ns();
         const auto gripper_tx_status =
             openarm_->get_gripper().mit_control_all(hand_cmds);
         telemetry_record.gripper_tx_expected_frame_count = gripper_tx_status.expected_frame_count;
         telemetry_record.gripper_tx_full_frame_write_count = gripper_tx_status.full_frame_write_count;
         telemetry_record.gripper_tx_failed_frame_write_count = gripper_tx_status.failed_frame_write_count;
         telemetry_record.socketcan_tx_enqueue_success =
             arm_tx_status.all_expected_frames_tx_enqueued() &&
             gripper_tx_status.all_expected_frames_tx_enqueued();
         telemetry_record.gripper_call_return_monotonic_ns =
             wam::openarm_bridge::monotonic_now_ns();
         telemetry_record.control_call_end_monotonic_ns =
             telemetry_record.gripper_call_return_monotonic_ns;
         if (follower_telemetry_ != nullptr) {
             follower_telemetry_->try_enqueue(telemetry_record);
         }
 
         openarm_->recv_all(200);
 
         return true;
     }
 
     return true;
 }
 
 void Control::ComputeFriction(const double* velocity, double* friction, size_t index) {
     if (TANHFRIC) {
         const double amp_tmp = 1.0;
         // tanh steepness scale: at the 0.1 default the Coulomb term barely engages
         // at hand speeds, so breakaway feels heavy. Raise via TELEOP_STICTION
         // (try 0.3) for lighter slow/fine motion; too high hums/chatters at rest.
         static const double coef_tmp = [] {
             const char* e = std::getenv("TELEOP_STICTION");
             return std::clamp(e != nullptr ? std::atof(e) : 0.1, 0.05, 1.0);
         }();
 
         const double v = velocity[index];
         const double Fc = Fc_.at(index);
         const double k = k_.at(index);
         const double Fv = Fv_.at(index);
         const double Fo = Fo_.at(index);
 
         friction[index] = amp_tmp * Fc * std::tanh(coef_tmp * k * v) + Fv * v + Fo;
     } else {
         friction[index] = velocity[index] * Dn_.at(index);
     }
 }
 
 bool Control::AdjustPosition(void) {
     int nstep = 220;
     double alpha;
 
     std::vector<MotorState> arm_motor_states;
     for (const auto& motor : openarm_->get_arm().get_motors()) {
         arm_motor_states.push_back({motor.get_position(), motor.get_velocity(), 0.0});
     }
 
     std::vector<MotorState> gripper_motor_states;
     for (const auto& motor : openarm_->get_gripper().get_motors()) {
         gripper_motor_states.push_back({motor.get_position(), motor.get_velocity(), 0.0});
